<node id="inv:G28-adj"><data key="n_type">invariant</data><data key="n_label">I-balance-not-decremented-twice(G28-adj)</data><data key="n_fidelity">real</data><data key="n_evidence">reports/implementation/m4-invariant-results.json (G28-adj: PASS)</data><data key="n_attrs">{"coverage": "executed", "negative_control": "Absent dedup, a second da_payout_processed would double the merchant-balance debit.", "result": "PASS", "statement": "A duplicate statement / replayed recon does not debit the merchant ledger balance a second time: no additional debit entries appear and the DA journal count is unchanged."}</data></node>
<node id="inv:G31"><data key="n_type">invariant</data><data key="n_label">I-Direct-failure-no-shared-reversal(G31)</data><data key="n_fidelity">real</data><data key="n_evidence">reports/implementation/m4-invariant-results.json (G31: PASS)</data><data key="n_attrs">{"coverage": "executed", "negative_control": "Shared (nodal) account: bank failed remaps to REVERSED with a reversal row (V18, test_v18).", "result": "PASS", "statement": "A failed Direct (rbl) payout produces NO reversal row and NO Shared-style reversal journal; the payout stays failed."}</data></node>
<node id="inv:G51"><data key="n_type">invariant</data><data key="n_label">I-conservation(G51)</data><data key="n_fidelity">real</data><data key="n_evidence">reports/implementation/m4-invariant-results.json (G51: PASS)</data><data key="n_attrs">{"coverage": "executed", "negative_control": "An unbalanced journal or a reservation/ledger amount != payout amount breaks conservation.", "result": "PASS", "statement": "For a successful Direct payout the DA journal entries sum to zero (sum_debit==sum_credit per journal) AND the modeled money-state is conserved across balance/reservation/ledger (reservation held==amount during pending, released on terminal; ledger merchant-balance debit==payout amount)."}</data></node>
<node id="inv:G53"><data key="n_type">invariant</data><data key="n_label">I-reservation-not-released-twice(G53)</data><data key="n_fidelity">real</data><data key="n_evidence">reports/implementation/m4-invariant-results.json (G53: PASS)</data><data key="n_attrs">{"coverage": "executed", "negative_control": "A double terminal-hook would remove/decrement the counter twice.", "result": "PASS", "statement": "An in-flight reservation transitions live -&gt; awaiting_balance_refresh -&gt; released AT MOST ONCE; re-running the reconciler does not double-release or duplicate the item."}</data></node>
<node id="inv:G54"><data key="n_type">invariant</data><data key="n_label">I-Direct-success-no-duplicate-ledger(G54)</data><data key="n_fidelity">real</data><data key="n_evidence">reports/implementation/m4-invariant-results.json (G54: PASS)</data><data key="n_attrs">{"coverage": "executed", "negative_control": "Without ledger layer-2 ValidateJournalExist the replay would write 4 journals.", "result": "PASS", "statement": "A processed Direct payout yields exactly two balanced DA journals (da_payout_processed + _recon); replaying the recon/payout_update path creates NO additional journal ((transactor_id,transactor_event) unique)."}</data></node>
<node id="inv:I01"><data key="n_type">invariant</data><data key="n_label">same X-Payout-Idempotency + same body -&gt; same payout id; different body -&gt; 400 SameIdempotencyKeyDifferentRequest</data><data key="n_fidelity">real</data><data key="n_evidence">payouts/internal/routing/middleware/idempotency_key.go:34-93; migrations/20221004002554:23; api MerchantIdempotencyHandler.php:84-210</data><data key="n_attrs">{"coverage": "source_inferred", "prod_enforced": "yes (PS idempotency_keys UNIQUE(idempotency_key, merchant_id), SHA-256 canonical body hash, Redis mutex 20 min)", "verifier": "V01, V02"}</data></node>
