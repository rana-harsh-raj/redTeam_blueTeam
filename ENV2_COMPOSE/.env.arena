# Env 2 arena — ports, image tags, network subnets. NO CREDENTIALS HERE.
# Credentials live only in ./secrets/ (generated by secrets/gen-secrets.sh).
#
# Always invoke compose as:
#   docker compose --env-file .env.arena -f docker-compose.yml <cmd>
# (scripts/*.sh do this for you.)

# Image tag applied to every rzp-arena/<svc> image built by build.sh /
# build-host.sh and referenced by docker-compose.yml.

# rzp-arena is internal:true (no egress); rzp-ingress is the only network
# with a path to the host, and kong-lite is the only container on both.
ARENA_SUBNET=172.28.16.0/24
INGRESS_SUBNET=172.28.17.0/24

# Host-side port for kong-lite, the sole arena entrypoint. Change if 18080
# collides with something else on the host.
KONG_LITE_HOST_PORT=18080

# mozart-mock (the REAL mozart binary in `-mock` mode) is CONFIRMED BLOCKED
# in this environment: `go build` of a real ../mozart clone fails on the
# private module github.com/razorpay/integrations-utils (404 for the build
# identity used) -- see substitutes/mozart-sim/CONTRACT.md. It stays defined
# under the opt-in `mozart-real` compose profile (not started by `substitutes`
# or `core`) in case a working credential is available in a future
# environment -- set MOZART_BUILD_CONTEXT and pass `--profile mozart-real`
# explicitly if so.
# MOZART_BUILD_CONTEXT=/absolute/path/to/mozart
# MOZART_DOCKERFILE_ABS is set automatically by build.sh from $(pwd); only
# override if invoking `docker compose build mozart-mock` directly.

# Which Mozart substitute FTS/x-balances/XAS point at:
# mozart-sim (lightweight Python stub, PRIMARY -- see above) or mozart-mock
# (real binary, currently unbuildable in this environment).
ARENA_MOZART_IMPL=mozart-sim

# ledger-migrate / fts-migrate need a `-dir` pointing at each repo's own
# migrations directory, mounted read-only (see docker-compose.yml's
# comments on those two services for exactly why -- ledger's needs a
# CI-only materialization step first, fts's flag name is unconfirmed).
# Absolute paths, e.g.:
# LEDGER_ARENA_PG_PASSWORD must match secrets/postgres_ledger_password.txt's
# current value (gen-secrets.sh rotates it -- re-export after every rotate):
# LEDGER_ARENA_PG_PASSWORD=$(cat secrets/postgres_ledger_password.txt)


# repo migration dirs (read-only mounts for the one-shot migrate jobs)
ARENA_TAG=v1-candidate
PAYOUTS_REPO_MIGRATIONS_DIR=/Users/rana.singh/rzp-payouts-architecture/.local/twin-runtime-migrations/accepted/payouts
LEDGER_REPO_MIGRATIONS_DIR=/Users/rana.singh/rzp-payouts-architecture/.local/twin-runtime-migrations/accepted/ledger
FTS_REPO_MIGRATIONS_DIR=/Users/rana.singh/rzp-payouts-architecture/.local/twin-runtime-migrations/accepted/fts
XBALANCES_REPO_MIGRATIONS_DIR=/Users/rana.singh/rzp-payouts-architecture/.local/twin-runtime-migrations/accepted/x-balances
FTS_REPO_CONFIG_DIR=/Users/rana.singh/rzp-payouts-architecture/.local/twin-repos/accepted/fts/config
